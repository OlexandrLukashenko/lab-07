{
  "compilerOptions": {
    "target": "ES2022", "module": "NodeNext", "moduleResolution": "NodeNext",
    "lib": ["ES2022", "DOM", "DOM.Iterable"], "rootDir": ".", "outDir": "dist",
    "strict": true, "noUncheckedIndexedAccess": true, "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true, "noFallthroughCasesInSwitch": true, "noPropertyAccessFromIndexSignature": true,
    "useUnknownInCatchVariables": true, "esModuleInterop": true, "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["shared/**/*.ts", "server/**/*.ts", "client/**/*.ts", "tests/**/*.ts", "vite.config.ts"]
}
